# Copy to .env (never commit it). All settings are optional.
APP_NAME="Courtside Analytics"
AUTHOR_NAME="Konstantinos Sakellariou"
REPO_URL=https://github.com/Konstantinos-Sakellariou/betting-dashboard
# Contact links in the footer and on the About page. Unset = the built-in default;
# set to an empty value to hide that link.
CONTACT_EMAIL=konstantinossakellariou@gmail.com
GITHUB_URL=https://github.com/Konstantinos-Sakellariou
LINKEDIN_URL=https://www.linkedin.com/in/konstantinos-sakellariou/
PORTFOLIO_URL=https://konstantinos-sakellariou.github.io/
# Offer CSV downloads of the prediction archive and game data.
ALLOW_CSV_EXPORT=true
# Show the "predictions paused" banner once the latest slate is this many days old.
STALE_AFTER_DAYS=3
DATA_DIR=data/processed
DEBUG=false
